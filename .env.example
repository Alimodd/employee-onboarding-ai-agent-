# Copy this file to .env and fill in your real key.
# Provider: Google Gemini (google-genai SDK). Get a key from Google AI Studio.
API_key=your_gemini_api_key_here

# --- Optional overrides (safe defaults exist in app/config.py) ---
# CHAT_MODEL=gemini-flash-latest
# EMBED_MODEL=gemini-embedding-001
# COLLECTION_NAME=company_policies
# TOP_K=3
# MAX_AGENT_ITERATIONS=5
# CHUNK_SIZE=500
# CHUNK_OVERLAP=80

# Backend URL used by the Streamlit frontend to reach FastAPI.
# BACKEND_URL=http://localhost:8000
